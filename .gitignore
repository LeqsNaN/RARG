# Large corpora — never commit corpus contents.
# The pre-built 100K corpus is available at:
# https://huggingface.co/datasets/lossisnotanumber/browsecomp-plus-100k-corpus-as-local-folder
corpus/

# Built indices and other large artifacts
data/indices/**/*.faiss
outputs/
models/

# HF upload staging (local-only)
corpus_hf_upload/

# Internal open-source preparation records (not for public repo)
MANIFEST.copied_files.txt
OPEN_SOURCE_NOTES.md

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
build/
dist/

# uv / lock caches
.uv_cache/

# OS / editor
.DS_Store
.idea/
.vscode/

# Local secrets / environment — never commit
.env
*.env
.env.local

# Logs
*.log

# Agent run outputs (large, removed from public history for hygiene)
outputs_for_demonstration/
